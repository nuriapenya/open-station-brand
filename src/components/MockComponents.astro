<div class="component-board" id="component-board" hidden>
	<div class="board-heading"><span class="mock-eyebrow">THE LITTLE THINGS</span><h2>Every detail, together.</h2><p>Try a control. Click a surface to make it yours.</p></div>
	<section class="component-tile"><h3>Buttons & actions</h3><div class="component-row"><button class="mock-primary" data-pick="--os-ui-accent">Create something</button><button class="mock-secondary" data-pick="--os-ui-button-bg">Secondary</button><button class="mock-secondary" disabled>Disabled</button></div><button class="mock-link" data-pick="--os-ui-accent">A little more detail →</button></section>
	<section class="component-tile"><h3>Inputs & choices</h3><label class="mock-input-label">Your next project<input placeholder="Something wonderful" aria-label="Mock project name"/></label><div class="component-row"><label><input type="checkbox" checked/> Keep me in the loop</label><button class="mock-switch" role="switch" aria-label="Preview component toggle" aria-checked="true"><span></span></button></div></section>
	<section class="component-tile"><h3>Feedback & status</h3><div class="component-row"><button class="mock-badge" data-pick="--os-ui-badge-success-bg">● Published</button><button class="mock-badge warning" data-pick="--os-ui-badge-warning-bg">● In progress</button><button class="mock-badge danger" data-pick="--os-ui-badge-danger-bg">● Needs attention</button></div><div class="mock-progress" role="progressbar" aria-label="Mock upload progress" aria-valuenow="68" aria-valuemin="0" aria-valuemax="100"><span></span></div><small>Uploading your next big thing… 68%</small></section>
	<section class="component-tile"><h3>Cards & surfaces</h3><button class="mock-feature-card" data-pick="--os-ui-card-bg"><div class="card-art"><span>✳</span></div><div><strong>Space to create</strong><span>A home for your ideas.</span></div><b>↗</b></button></section>
	<section class="component-tile table-tile"><h3>Tables & lists</h3><table class="mock-table"><thead><tr><th>Project</th><th>Status</th><th>Updated</th></tr></thead><tbody><tr><td><button data-pick="--os-ui-table-bg">A new beginning</button></td><td>Published</td><td>Just now</td></tr><tr><td>Notes from the studio</td><td>Draft</td><td>2 hours ago</td></tr><tr><td>Our little corner</td><td>Published</td><td>Yesterday</td></tr></tbody></table></section>
</div>
